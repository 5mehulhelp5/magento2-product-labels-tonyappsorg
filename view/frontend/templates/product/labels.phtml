<?php $labels = $block->getLabels($block->getProduct()); ?>
<?php if ($labels): ?>
<?php // css_class goes on a wrapper: a theme's utility class (Hyvä's md:hidden) loses to this module's own CSS on the same element. ?>
<?php if ($wrapper = (string)$block->getData('css_class')): ?><div class="<?= $block->escapeHtmlAttr($wrapper) ?>"><?php endif; ?>
<div class="tonyapps-product-labels">
    <?php foreach ($labels as $label): ?>
        <span class="tonyapps-product-label" style="background-color:<?= $block->escapeHtmlAttr($label['background_color']) ?>;color:<?= $block->escapeHtmlAttr($label['text_color']) ?>"><?= $block->escapeHtml($label['label']) ?></span>
    <?php endforeach; ?>
</div>
<?php if ($wrapper): ?></div><?php endif; ?>
<?php endif; ?>
